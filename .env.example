# Official/RSS material is the fact base. X/Threads data is reaction evidence.
INTEGRATED_RESEARCH_ENABLED=true
INTEGRATED_RESEARCH_POST_ENABLED=true
INTEGRATED_RESEARCH_MIN_SOURCE_FAMILIES=2
