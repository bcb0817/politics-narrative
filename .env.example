PROMPT_VERSION=x-growth-quality-v2
ENGAGEMENT_QUEUE_SCHEDULE=12:20,20:20
QUOTE_CANDIDATES_MAX_PER_RUN=3
REPLY_CANDIDATES_MAX_PER_RUN=5
FOLLOWER_SNAPSHOT_SCHEDULE=00:05,23:55
ENGAGEMENT_ROI_MIN_SAMPLE_SIZE=10
FOLLOW_CONVERSION_MIN_SAMPLE_SIZE=10
DIGEST_COMPARISON_MIN_SAMPLE_SIZE=10
CONTENT_PIPELINE_ENABLED=true
