WEEKLY_BATCH_SUBMIT_TIME=22:30
WEEKLY_BATCH_COLLECT_DAY=MON
WEEKLY_BATCH_COLLECT_TIME=04:15
EMOJI_MODE=selective
EMOJI_TARGET_RATIO=0.25
EMOJI_MAX_PER_POST=1
QUOTE_CANDIDATE_QUEUE_ENABLED=true
QUOTE_CANDIDATES_MAX_PER_DAY=5
QUOTE_COMMENT_OPTIONS_PER_ITEM=3
REPLY_CANDIDATE_QUEUE_ENABLED=true
REPLY_CANDIDATES_MAX_PER_DAY=10
REPLY_MENTION_FETCH_ENABLED=true
REPOST_AUTO_ENABLED=false
LIKE_AUTO_ENABLED=false
FOLLOW_AUTO_ENABLED=false


# 司法・法案など重要テーマを上位モデルへ回すキーワード（任意で上書き）
# OPENAI_IMPORTANT_KEYWORDS=首相,国会,法案,再審,裁判,司法,検察,証拠開示,冤罪

# --- Daily performance review ---
