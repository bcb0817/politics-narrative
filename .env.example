# politics-narrative ローカル運用設定
# 使い方: このファイルを .env にコピーして値を埋める（.env はコミットしない）
#   cp .env.example .env

# --- X API (developer.x.com) ---
API_KEY=
API_KEY_SECRET=
ACCESS_TOKEN=
ACCESS_TOKEN_SECRET=

# --- X Search（Recent Search / API v2）---
# Xは事実情報源ではなく、RSS候補の注目度レーダーとしてだけ使う。
X_SEARCH_ENABLED=true
X_BEARER_TOKEN=
X_SEARCH_RUNS_PER_DAY=3
X_SEARCH_SCHEDULE=06:00,12:00,18:00
X_SEARCH_MAX_QUERIES_PER_RUN=3
X_SEARCH_MAX_RESULTS_PER_QUERY=6
X_SEARCH_LOOKBACK_MINUTES=240
X_SEARCH_CACHE_TTL_MINUTES=360
X_SEARCH_REUSE_RESULTS=true
X_SEARCH_MIN_UNIQUE_ACCOUNTS=3
X_SEARCH_WEIGHT=0.20
X_SEARCH_MIN_POST_COUNT=3
X_SEARCH_MAX_TOPIC_RESULTS=10
X_DISCORD_RESEARCH_ENABLED=true
# 監視は毎時00分。X Searchは指定した3時刻だけ更新し、それ以外はキャッシュを使う。
SOURCE_SCHEDULE_SPLIT=false

# --- OpenAI API ---
OPENAI_API_KEY=

# 非即時のレビューだけを24時間以内の非同期Batch APIへ送る。
# 投稿生成・重大速報・分類は同期APIのまま維持する。
OPENAI_BATCH_ENABLED=true
OPENAI_BATCH_TASKS=weekly_report,quality_eval

# 中央モデルルーター。分類器・週次・プレミアムは初期状態で無効。
OPENAI_MODEL_CLASSIFIER=gpt-5.4-nano
OPENAI_MODEL_POST=gpt-5.4-mini
OPENAI_MODEL_DEFAULT=gpt-5.4-mini
OPENAI_MODEL_IMPORTANT=gpt-5.6-luna
OPENAI_MODEL_DAILY_REVIEW=gpt-5.4-mini
OPENAI_MODEL_WEEKLY_REPORT=gpt-5.6-terra
OPENAI_MODEL_WEEKLY_REVIEW=gpt-5.6-terra
OPENAI_MODEL_PREMIUM=gpt-5.6-sol
OPENAI_CLASSIFIER_ENABLED=true
WEEKLY_REPORT_ENABLED=true
OPENAI_PREMIUM_ENABLED=false
OPENAI_MODEL_POST_FALLBACK=gpt-5-mini
OPENAI_MODEL_CLASSIFIER_FALLBACK=gpt-5-nano
OPENAI_MODEL_DAILY_REVIEW_FALLBACK=local_only
OPENAI_MODEL_WEEKLY_REVIEW_FALLBACK=gpt-5.6-luna

OPENAI_REASONING_EFFORT_CLASSIFIER=none
OPENAI_REASONING_EFFORT_POST=low
OPENAI_REASONING_EFFORT_DEFAULT=none
OPENAI_REASONING_EFFORT_IMPORTANT=low
OPENAI_REASONING_EFFORT_DAILY_REVIEW=low
OPENAI_REASONING_EFFORT_WEEKLY_REPORT=medium
OPENAI_REASONING_EFFORT_WEEKLY_REVIEW=medium
OPENAI_REASONING_EFFORT_PREMIUM=medium
OPENAI_MAX_OUTPUT_TOKENS_POST=1800
OPENAI_MAX_OUTPUT_TOKENS_DAILY_REVIEW=3000
OPENAI_MAX_OUTPUT_TOKENS_CLASSIFIER=600
OPENAI_MAX_OUTPUT_TOKENS_WEEKLY_REPORT=5000
OPENAI_MAX_RETRIES=1
IMPORTANT_NEWS_SCORE_THRESHOLD=8.0
DAILY_IMPORTANT_MODEL_LIMIT=6
DAILY_REVIEW_MODEL_LIMIT=1
OPENAI_CLASSIFIER_MAX_CALLS_PER_DAY=6
OPENAI_DAILY_REVIEW_MAX_CALLS_PER_DAY=1
OPENAI_WEEKLY_REVIEW_MAX_CALLS_PER_WEEK=1

# 旧設定名は互換読込のみ。新規運用では上記の用途別設定を使う。
OPENAI_REASONING_EFFORT=none
OPENAI_MAX_OUTPUT_TOKENS=1800

# OpenAI APIだけの月間推定予算。到達すると候補生成を停止する（0で無効）
OPENAI_MONTHLY_BUDGET_USD=15.0
OPENAI_POST_BUDGET_USD=9.00
OPENAI_IMPORTANT_POST_BUDGET_USD=1.50
OPENAI_CLASSIFIER_BUDGET_USD=0.75
OPENAI_DAILY_REVIEW_BUDGET_USD=1.00
OPENAI_WEEKLY_REVIEW_BUDGET_USD=0.75
OPENAI_QUALITY_EVAL_BUDGET_USD=0.50
OPENAI_CONTENT_PIPELINE_BUDGET_USD=0.50
# A/B候補だけに使う任意のOpenAI生成器。既定OFF、外部投稿は常に行わない。
# 入力は同一fact packetだけで、過去実績・勝敗・公開投稿は送信しない。
POST_EXPERIMENT_OPENAI_ENABLED=false
POST_EXPERIMENT_OPENAI_MODEL=gpt-5.6-luna
POST_EXPERIMENT_OPENAI_MAX_OUTPUT_TOKENS=1800
POST_EXPERIMENT_OPENAI_MAX_COST_USD=0.08
POST_EXPERIMENT_OPENAI_MONTHLY_BUDGET_USD=0.50
OPENAI_BUDGET_RESERVE_USD=1.00
XAI_MONTHLY_BUDGET_USD=30.0
XAI_VERIFIED_EFFECTIVE_LIMIT_USD=30.0
XAI_UNVERIFIED_EFFECTIVE_LIMIT_USD=7.5
XAI_ALLOW_UNVERIFIED_FULL_BUDGET=false
XAI_BUDGET_RESERVE_USD=1.50
X_MONTHLY_BUDGET_USD=16.0
TOTAL_MONTHLY_API_BUDGET_USD=61.0
X_BUDGET_RESERVE_USD=0.75
TOTAL_BUDGET_RESERVE_USD=3.25
BUDGET_USD_JPY_RATE=165
MONTHLY_BUDGET_JPY=10065
BUDGET_WARNING_RATIO=0.85
BUDGET_RESTRICT_RATIO=0.93
BUDGET_HARD_STOP_RATIO=1.00
OPENAI_TIMEOUT_SECONDS=90

# --- 政治投稿の多段階生成（OpenAI Responses APIのみ）---
# 空のモデル設定は中央モデルルーターが選んだ既存モデルを継承する。
POLITICS_ANALYSIS_MODEL=
POLITICS_WRITER_MODEL=
POLITICS_JUDGE_MODEL=
POLITICS_FINALIZER_MODEL=
POLITICS_ANGLE_COUNT=6
POLITICS_CANDIDATE_COUNT=6
POLITICS_MIN_FACTUAL_SCORE=8
POLITICS_MAX_DEFAMATION_RISK=3
POLITICS_MAX_INFERENCE_RISK=4
POLITICS_ENABLE_SEMANTIC_DEDUP=true
# 空ならローカル類似度のみ。利用可能なEmbeddingモデルを明示した場合だけAPI判定を追加。
POLITICS_EMBEDDING_MODEL=
POLITICS_SEMANTIC_DEDUP_THRESHOLD=0.88
POLITICS_ENABLE_MULTI_STAGE_GENERATION=true
POLITICS_FALLBACK_TO_LEGACY=true
POLITICS_MAX_API_CALLS_PER_ARTICLE=12
POLITICS_LEGACY_FALLBACK_RESERVE_CALLS=1
# 空なら既存のPREFILTER_TOP_Nを使用する。
POLITICS_MAX_ARTICLES_PER_RUN=
POLITICS_CACHE_TTL_HOURS=24
POLITICS_CANDIDATE_CACHE_ENABLED=true
POLITICS_CANDIDATE_CACHE_TTL_HOURS=4
POLITICS_MOCK_LLM=false
POLITICS_FETCH_ARTICLE_BODY=true
POLITICS_ARTICLE_FETCH_TIMEOUT_SECONDS=8
POLITICS_ARTICLE_MAX_BYTES=1000000
POLITICS_ARTICLE_MAX_CHARS=8000
# falseでは候補本文をログへ保存せず、判断理由とスコアだけを残す。
POLITICS_DEBUG_GENERATION=false

# 価格変更や別モデル利用時に上書き可能（USD / 100万tokens）
OPENAI_DEFAULT_INPUT_USD_PER_1M=0.05
OPENAI_DEFAULT_CACHED_INPUT_USD_PER_1M=0.005
OPENAI_DEFAULT_OUTPUT_USD_PER_1M=0.40
OPENAI_IMPORTANT_INPUT_USD_PER_1M=0.25
OPENAI_IMPORTANT_CACHED_INPUT_USD_PER_1M=0.025
OPENAI_IMPORTANT_OUTPUT_USD_PER_1M=2.00

# --- 時刻 ---
TZ=Asia/Tokyo
DISABLE_TIME_API=true

# --- 投稿判定 ---
POST_WINDOW_MINUTES=20
CATCH_UP_HOURS=3
MAX_POSTS_PER_RUN=1
MIN_POST_SCORE=7.0
ORIGINAL_DAILY_POST_MIN=6
ORIGINAL_DAILY_POST_MAX=8
NORMAL_DAILY_POST_MIN=6
NORMAL_DAILY_POST_MAX=8
BREAKING_DAILY_POST_LIMIT=2
MAX_DAILY_AUTOMATED_POSTS=10
MAX_DAILY_POSTS=10
MIN_POST_INTERVAL_MINUTES=60
TOPIC_COOLDOWN_HOURS=4
SEMANTIC_TOPIC_COOLDOWN_HOURS=72
# 最終成功投稿からこの時間以上空いた場合、得点・型・テーマ枠だけを緩和する。
# 救済時も同一政策の意味的重複と上記72時間の制限は緩和しない。
# 未確認情報、BANリスク、政治関連性、重複URLなどの安全ゲートは維持する。
LOW_QUALITY_FALLBACK_HOURS=1.5
LOW_QUALITY_FALLBACK_ENABLED=true
LOW_QUALITY_FALLBACK_MIN_SCORE=4.5
EVERGREEN_FALLBACK_ENABLED=true
EVERGREEN_MIN_SILENCE_HOURS=3
EVERGREEN_MAX_PER_DAY=1
EVERGREEN_MIN_QUALITY_SCORE=7.0
EVERGREEN_REQUIRE_VERIFIED_FACTS=true
PREFILTER_TOP_N=1
# 公開時刻を解釈できる記事は、これより古ければ投稿候補から除外
MAX_NEWS_AGE_HOURS=12

# --- スロット間隔・生成数（コストに直結） ---
# SLOT_INTERVAL_MINUTES: 投稿スロットの間隔（分）。1440を割り切る値のみ有効。
#   30=1日48回 / 45=1日32回 / 60=1日24回。大きいほど実行回数が減りコスト減。
SLOT_INTERVAL_MINUTES=60
# 通常3案、重要テーマ5案。最終的に安全・品質判定を通った1案だけ投稿。
CANDIDATES_PER_NEWS=3
# ACTIVE_HOURS: 投稿する時間帯（JST・両端含む）。人がXを見ている時間だけに絞ると
# 投稿あたりのインプレッションが上がる。空なら24時間投稿。
#   推奨: 朝の通勤 7-8 / 昼休み 12 / 夜のゴールデン 18-23
ACTIVE_HOURS=5-23
DIGEST_HOURS=6,18

# --- 投稿審査 ---
# QUALITY_GATE_ENABLED: 品質スコア(MIN_POST_SCORE)による投稿審査を行うか。
# true（推奨）= MIN_POST_SCORE未満を投稿せず、report コマンドの実績で改善する運用。
# BANリスク判定はこの設定に関係なく常時有効（無効化不可）。
QUALITY_GATE_ENABLED=true

# --- スレッド（返信での分割） ---
# false（既定）= 単発投稿のみ。true = 補足を返信でぶら下げる
THREAD_ENABLED=false
MAX_BAN_RISK=3
MAX_REGENERATION_ATTEMPTS=1

# --- ディレクトリ（相対パスはリポジトリ直下基準） ---
STATE_DIR=data
LOG_DIR=logs

# --- 定期ストレージ整理（JST毎日03:30、デーモン内で実行）---
# DB、状態JSON、下書き、公開物、災害資料、調査資料、backups/は削除しない。
STORAGE_CLEANUP_ENABLED=true
STORAGE_CLEANUP_SCHEDULE=03:30
STORAGE_POLITICS_CACHE_DAYS=2
STORAGE_ARTICLE_CACHE_DAYS=2
STORAGE_SEARCH_HISTORY_DAYS=45
STORAGE_OPENAI_BATCH_DAYS=30
STORAGE_PREVIEW_DAYS=14
STORAGE_FAILED_DRAFT_DAYS=30
STORAGE_LOG_RETENTION_DAYS=30
STORAGE_LOG_MAX_MB=10
STORAGE_PYCACHE_DAYS=2
STORAGE_CLEANUP_MAX_DELETIONS=5000

# --- 安全弁 ---
# true にしない限り、X への実投稿は行われない（候補生成までは実行される）
POST_ENABLED=false

# 投稿形式はテキスト専用です。画像生成・画像添付機能は廃止済みです。

# POST_ENABLED=false の run を attempted_slots.json に記録するか
# false（既定）: ローカルテスト/dry-runでslotを消費しない（本番投稿前にslotを処理済みにしない）
MARK_DISABLED_RUN_AS_ATTEMPTED=false

# --- Phase control / X resource caps ---
PHASE1_ENABLED=true
PHASE2_ENABLED=true
PHASE3_ENABLED=true
MONITOR_INTERVAL_MINUTES=60
MONITOR_SCHEDULE_MINUTE=0
X_SEARCH_MAX_POST_READS_PER_RUN=18
X_SEARCH_MAX_POST_READS_PER_DAY=54
X_SEARCH_MAX_POST_READS_PER_MONTH=1620
X_OWNED_READ_MAX_PER_DAY=36
X_OWNED_READ_MAX_PER_MONTH=1080
X_POST_CREATE_MAX_PER_DAY=10
X_POST_CREATE_MAX_PER_MONTH=300

# --- Metrics / weekly review ---
POST_METRICS_ENABLED=true
POST_METRICS_WINDOWS=15m,1h,6h,24h,72h
DAILY_REVIEW_ENABLED=true
DAILY_REVIEW_TIME=04:40
DAILY_REVIEW_MODE=synchronous
DAILY_REVIEW_DEADLINE=04:55
DAILY_REVIEW_MAX_API_CALLS=1
OPENAI_DAILY_REVIEW_MAX_CALLS_PER_DAY=1
WEEKLY_REVIEW_ENABLED=true
WEEKLY_REVIEW_DAY=MON
WEEKLY_REVIEW_TIME=04:15

# --- Preview-only extensions（自動投稿は常に無効） ---
THREAD_PREVIEW_ENABLED=true
POLL_PREVIEW_ENABLED=true
QUOTE_PREVIEW_ENABLED=true
REPLY_PREVIEW_ENABLED=true
SHORTS_PREVIEW_ENABLED=true
NOTE_PREVIEW_ENABLED=true
THREAD_AUTO_POST_ENABLED=false
POLL_AUTO_POST_ENABLED=false
QUOTE_AUTO_POST_ENABLED=false
REPLY_AUTO_POST_ENABLED=false
IMAGE_POST_ENABLED=false

# --- xAI radar and paid-provider exclusivity ---
X_TOPIC_DISCOVERY_PROVIDER=xai
X_NATIVE_SEARCH_ENABLED=false
XAI_ENABLED=true
XAI_API_KEY=
XAI_MODEL=grok-4.5
XAI_SEARCH_SCHEDULE=06:00,09:00,12:00,15:00,18:00,21:00
XAI_SEARCH_MAX_CALLS_PER_DAY=6
